<Entity name="shiniestOrbStone">
    <Base file="mods/blankStone/files/entities/elemental_stone.xml">

        <!-- physical presence -->

        <PhysicsImageShapeComponent
            image_file="mods/blankStone/files/items_gfx/elemental_stone/stone_shiniest_orb.png"
        ></PhysicsImageShapeComponent>

        <!-- item -->

        <SpriteComponent
            image_file="mods/blankStone/files/items_gfx/elemental_stone/stone_shiniest_orb.png"
        ></SpriteComponent>

        <ItemComponent
            item_name="$stone_blankstone_shiniestOrbStone_name"
            ui_description="$stone_blankstone_shiniestOrbStone_desc"
            ui_sprite="mods/blankStone/files/ui_gfx/elemental_stone/stone_shiniest_orb.png"
        ></ItemComponent>

        <UIInfoComponent
            name="$stone_blankstone_shiniestOrbStone_name"
        ></UIInfoComponent>

        <AbilityComponent
            ui_name="$stone_blankstone_shiniestOrbStone_name"
        ></AbilityComponent>
    </Base>

    <!-- VFX Halo -->
    <Base file="mods/blankStone/files/VFX/halo.xml">
        <SpriteParticleEmitterComponent
            color.r="0.6" color.g="0.5" color.b="0" color.a="0.25"
            color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="-1.5"
            additive="1"
            emissive="1"
        ></SpriteParticleEmitterComponent>
    </Base>

    <VariableStorageComponent
        name="blankStoneID"
        value_string="shiniestOrbStone"
    ></VariableStorageComponent>

    <LuaComponent
        _tags="enabled_in_hand,enabled_in_inventory"
        script_source_file="mods/blankStone/files/scripts/status_effects/generic_game_effect_watchdog.lua"
        execute_every_n_frame="30"
    ></LuaComponent>

    <VariableStorageComponent
        name="watchdog_game_effect"
        value_string="EXTRA_MONEY*greed_count"
    ></VariableStorageComponent>

    <LuaComponent
        _tags="enabled_in_world,enabled_in_hand"
        script_kick="mods/blankStone/files/scripts/stone_specific_script/shiniest_orb_kick.lua"
        execute_every_n_frame="-1"
    > </LuaComponent>

</Entity>