<Entity name="apoFlyStone">

    <Base file="mods/blankStone/files/entities/elemental_stone.xml">
        <PhysicsImageShapeComponent
            image_file="mods/blankStone/files/items_gfx/elemental_stone/apotheosis/apo_stone_fly.png"
        ></PhysicsImageShapeComponent>

        <SpriteComponent
            image_file="mods/blankStone/files/items_gfx/elemental_stone/apotheosis/apo_stone_fly.png"
        ></SpriteComponent>

        <ItemComponent
            item_name="$stone_blankstone_apoFlyStone_name"
            ui_description="$stone_blankstone_apoFlyStone_desc"
            ui_sprite="mods/blankStone/files/ui_gfx/elemental_stone/apotheosis/apo_stone_fly.png"
        ></ItemComponent>

        <UIInfoComponent
            name="$stone_blankstone_apoFlyStone_name"
        ></UIInfoComponent>

        <AbilityComponent
            ui_name="$stone_blankstone_apoFlyStone_name"
        ></AbilityComponent>
    </Base>

    <!-- VFX -->

    <Base file="mods/blankStone/files/VFX/halo.xml">
        <SpriteParticleEmitterComponent
            color.r="0.6" color.g="0.3" color.b="0.3" color.a="0.15"
            color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="-1.5"
            additive="1"
            emissive="1"
        ></SpriteParticleEmitterComponent>
    </Base>

    <!-- effect -->

    <!-- === CUSTOM EFFECT === -->
    <LuaComponent
        _tags="enabled_in_hand,enabled_in_inventory"
        script_source_file="mods/blankStone/files/scripts/status_effects/custom_effect_stone.lua"
        execute_every_n_frame="30"
    ></LuaComponent>

    <!-- Required -->
    <VariableStorageComponent
        name="custom_id"
        value_string="INFINITE_FLIGHT"
    ></VariableStorageComponent>
    <!-- ============================== -->

    <VariableStorageComponent
        name="blankStoneID"
        value_string="apoFlyStone"
    ></VariableStorageComponent>

</Entity>