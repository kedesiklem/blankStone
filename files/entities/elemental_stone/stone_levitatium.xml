<Entity name="levitatiumStone">

  <Base file="mods/blankStone/files/entities/elemental_stone.xml">
    <PhysicsImageShapeComponent
      image_file="mods/blankStone/files/items_gfx/elemental_stone/stone_levitatium.png"
    ></PhysicsImageShapeComponent>

    <SpriteComponent
      image_file="mods/blankStone/files/items_gfx/elemental_stone/stone_levitatium.png"
    ></SpriteComponent>

    <ItemComponent
      item_name="$stone_blankstone_levitatiumStone_name"
      ui_description="$stone_blankstone_levitatiumStone_desc"
      ui_sprite="mods/blankStone/files/ui_gfx/elemental_stone/stone_levitatium.png"
    ></ItemComponent>

    <UIInfoComponent
      name="$stone_blankstone_levitatiumStone_name"
    ></UIInfoComponent>

    <AbilityComponent
      ui_name="$stone_blankstone_levitatiumStone_name"
    ></AbilityComponent>
  </Base>

  <Base file="mods/blankStone/files/entities/infusable.xml" include_children="1" />


  <!-- VFX -->

  <Base file="mods/blankStone/files/VFX/halo.xml">
    <SpriteParticleEmitterComponent
      color.r="0.4" color.g="0.3" color.b="0.3" color.a="0.15"
      color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="-1.5"
      additive="1"
      emissive="1"
    ></SpriteParticleEmitterComponent>
  </Base>

  <!-- effect -->

  <!-- GAME EFFECT WITH WATCHDOG FOR STORAGE HANDLING -->
  <LuaComponent
    _tags="enabled_in_hand,enabled_in_inventory"
    script_source_file="mods/blankStone/files/scripts/status_effects/generic_game_effect_watchdog.lua"
    execute_every_n_frame="30"
  ></LuaComponent>

  <VariableStorageComponent
    name="watchdog_game_effect"
    value_string="FASTER_LEVITATION"
  ></VariableStorageComponent>
  <!-- ============================================= -->

  <VariableStorageComponent
    name="blankStoneID"
    value_string="levitatiumStone"
  ></VariableStorageComponent>

</Entity>