<Entity tags="glue_NOT" name="mimicStone">

    <Base file="mods/blankStone/files/entities/base_stone.xml">

        <SpriteParticleEmitterComponent _remove_from_base="1" />

        <PhysicsBodyComponent
            _tags="enabled_in_world"
            uid="1"
            allow_sleep="1"
            angular_damping="0"
            fixed_rotation="0"
            is_bullet="1"
            linear_damping="0"
            auto_clean="0"
            on_death_leave_physics_body="1"
            hax_fix_going_through_ground="1"
        ></PhysicsBodyComponent>

        <PhysicsImageShapeComponent
            _tags="enabled_in_world"
            body_id="1"
            centered="1"
            image_file="mods/blankStone/files/items_gfx/blank_stone.png"
            material="rock_box2d_hard"
        ></PhysicsImageShapeComponent>

        <!-- only pickable when charmed -->
        <ItemComponent
            _enabled="0"
            _tags="enabled_if_charmed"
            item_name="$stone_blankstone_blankStone_name"
            ui_description="$stone_blankstone_blankStone_desc"
            ui_sprite="mods/blankStone/files/ui_gfx/blank_stone.png"
            max_child_items="0"
            is_pickable="1"
            is_equipable_forced="1"
            preferred_inventory="QUICK"
        ></ItemComponent>

        <UIInfoComponent
            _tags="enabled_in_world"
            name="$stone_blankstone_blankStone_name"
        ></UIInfoComponent>

        <AbilityComponent
            ui_name="$stone_blankstone_blankStone_name"
            throw_as_item="1"
        >
            <gun_config deck_capacity="0"></gun_config>
        </AbilityComponent>

        <!-- in-hand display -->
        <SpriteComponent
            _enabled="0"
            _tags="enabled_in_hand"
            z_index="1.05"
            image_file="mods/blankStone/files/items_gfx/blank_stone.png"
        ></SpriteComponent>

    </Base>

    <Base file="data/entities/base_enemy_flying.xml">

        <ItemChestComponent
            _enabled="0"
            enemy_drop="0"
            item_count_min="0"
            item_count_max="0"
        ></ItemChestComponent>

        <AnimalAIComponent
            _tags="enabled_in_world"
            _enabled="1"
            preferred_job="JobDefault"
            keep_state_alive_when_enabled="1"
            escape_if_damaged_probability="35"
            attack_dash_enabled="0"
            attack_dash_damage="0"
            creature_detection_range_x="250"
            creature_detection_range_y="250"
            needs_food="0"
            sense_creatures="1"
            attack_ranged_enabled="0"
            attack_melee_enabled="0"
            can_fly="0"
        ></AnimalAIComponent>

        <PathFindingComponent
            _tags="enabled_in_world"
            distance_to_reach_node_x="20"
            distance_to_reach_node_y="20"
            frames_to_get_stuck="20"
            can_swim_on_surface="1"
            can_dive="1"
            can_walk="1"
            can_jump="1"
            jump_speed="100"
            initial_jump_lob="1"
            initial_jump_max_distance_x="40"
            initial_jump_max_distance_y="-30">
            <jump_trajectories>
                <JumpTrajectory x="5" y="15" lob="1" />
                <JumpTrajectory x="7" y="20" lob="1" />
                <JumpTrajectory x="10" y="-60" lob="1" />
                <JumpTrajectory x="40" y="-10" lob="1" />
                <JumpTrajectory x="40" y="-35" lob="1" />
                <JumpTrajectory x="60" y="-40" lob="1" />
                <JumpTrajectory x="60" y="75" lob="1" />
            </jump_trajectories>
        </PathFindingComponent>

        <PathFindingGridMarkerComponent
            _tags="enabled_in_world"
            marker_work_flag="16"
        ></PathFindingGridMarkerComponent>

        <CharacterCollisionComponent
            _tags="enabled_in_world"
            getting_crushed_threshold="6"
            moving_up_before_getting_crushed_threshold="6"
        ></CharacterCollisionComponent>

        <CharacterDataComponent
            _tags="enabled_in_world"
            platforming_type="0"
            dont_update_velocity_and_xform="1"
            collision_aabb_min_x="-2"
            collision_aabb_max_x="2"
            collision_aabb_min_y="-2"
            collision_aabb_max_y="0"
            mass="1.9"
        ></CharacterDataComponent>

        <GenomeDataComponent
            _tags="enabled_in_world"
            herd_id="ghost"
            food_chain_rank="7"
            is_predator="1"
        ></GenomeDataComponent>

        <CharacterPlatformingComponent
            _tags="enabled_in_world"
            jump_velocity_y="-12"
            run_velocity="0"
            audio_liquid_splash_intensity="0.2"
        ></CharacterPlatformingComponent>

        <ControlsComponent
            _tags="enabled_in_world"
            enabled="0"
        ></ControlsComponent>

        <HitboxComponent
            _tags="enabled_in_world"
            _enabled="1"
            aabb_min_x="-3"
            aabb_max_x="3"
            aabb_min_y="-3"
            aabb_max_y="3"
        ></HitboxComponent>

        <SpriteAnimatorComponent
            _tags="enabled_in_world"
        ></SpriteAnimatorComponent>

        <SpriteStainsComponent
            _tags="enabled_in_world"
            _enabled="1"
            sprite_id="1"
        ></SpriteStainsComponent>

        <StatusEffectDataComponent
            _tags="enabled_in_world"
        ></StatusEffectDataComponent>

        <AudioComponent
            _tags="enabled_in_world,enabled_in_hand"
            file="data/audio/Desktop/animals.bank"
            event_root="animals/mimic_potion"
        ></AudioComponent>

        <!-- serialization correcte -->
        <CameraBoundComponent _remove_from_base="1" />

        <!-- pas de doublon de sprite, on déclare le notre en bas -->
        <SpriteComponent _remove_from_base="1" />

        <!-- pas de drop d'or -->
        <LuaComponent _remove_from_base="1" />

        <!-- déjà fourni par base_stone -->
        <VelocityComponent _remove_from_base="1" />

        <!-- on déclare le notre explicitement -->
        <DamageModelComponent _remove_from_base="1" />

    </Base>

    <!-- pierre : pas de sang, pas de ragdoll, résiste au feu -->
    <DamageModelComponent
        _tags="enabled_in_world"
        air_needed="0"
        blood_material=""
        drop_items_on_death="0"
        falling_damages="0"
        fire_damage_amount="0"
        fire_probability_of_ignition="0"
        critical_damage_resistance="1"
        hp="2"
        is_on_fire="0"
        materials_create_messages="0"
        materials_damage="1"
        materials_that_damage="lava"
        materials_how_much_damage="0.001"
        ragdoll_filenames_file=""
        ragdoll_material=""
    ></DamageModelComponent>

    <PhysicsAIComponent
        _tags="enabled_in_world"
        target_vec_max_len="15.0"
        force_coeff="20.0"
        force_balancing_coeff="0.8"
        force_max="30"
        torque_coeff="5"
        torque_balancing_coeff="0.8"
        torque_max="0"
        torque_jump_random="3.5"
        damage_deactivation_probability="80"
        damage_deactivation_time_min="60"
        damage_deactivation_time_max="120"
        die_on_remaining_mass_percentage="0.5"
        levitate="0"
        v0_swim_logic="0"
        v0_jump_logic="0"
        v0_body_id_logic="0"
        torque_damaged_max="10"
    ></PhysicsAIComponent>

    <LuaComponent
        _tags="enabled_in_world,enabled_in_hand"
        call_init_function="1"
        script_source_file="mods/blankStone/files/scripts/animals/mimic_stone.lua"
        script_death="mods/blankStone/files/scripts/animals/mimic_stone.lua"
        script_enabled_changed="mods/blankStone/files/scripts/animals/mimic_stone.lua"
        execute_on_added="1"
        execute_every_n_frame="30"
    ></LuaComponent>

    <IKLimbsAnimatorComponent
        _tags="enabled_in_world,enabled_in_hand"
        ray_skip_material="rock_box2d_hard"
        no_ground_attachment_penalty_coeff="0.01"
    ></IKLimbsAnimatorComponent>

    <AudioComponent
        _tags="enabled_in_world"
        file="data/audio/Desktop/animals.bank"
        event_root="animals/lukki_tiny"
    ></AudioComponent>

    <!-- sprite principal -->
    <SpriteComponent
        _tags="enabled_in_world"
        _enabled="1"
        offset_x="4"
        offset_y="4"
        image_file="mods/blankStone/files/items_gfx/blank_stone.png"
    ></SpriteComponent>

    <MusicEnergyAffectorComponent
        energy_target="0.5"
        fade_range="256"
        energy_lerp_up_speed_multiplier="4"
        is_enemy="0"> </MusicEnergyAffectorComponent>

    <MusicEnergyAffectorComponent
        energy_target="0.0"
        fade_range="256"
        energy_lerp_up_speed_multiplier="4"
        is_enemy="0"> </MusicEnergyAffectorComponent>

    <Entity>
        <Base file="data/entities/animals/lukki/lukki_feet/lukki_limb_tiny_dark_animated.xml" />
    </Entity>
    <Entity>
        <Base file="data/entities/animals/lukki/lukki_feet/lukki_limb_tiny_dark_animated.xml" />
    </Entity>
    <Entity>
        <Base file="data/entities/animals/lukki/lukki_feet/lukki_limb_tiny_dark_animated.xml" />
    </Entity>
    <Entity>
        <Base file="data/entities/animals/lukki/lukki_feet/lukki_limb_tiny_dark_animated.xml" />
    </Entity>
    <Entity>
        <Base file="data/entities/animals/lukki/lukki_feet/lukki_limb_tiny_dark_animated.xml" />
    </Entity>

    <VariableStorageComponent
        name="blankStoneID"
        value_string="mimicStone"
    ></VariableStorageComponent>


</Entity>